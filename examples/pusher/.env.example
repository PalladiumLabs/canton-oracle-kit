# canton-oracle-pusher configuration. Copy to .env (never commit it) and fill in.
# All values below are placeholders. Party ids look like `name::1220<fingerprint>`.

# ---------------------------------------------------------------------------------------------------
# Chainlink Data Streams (REST, HMAC-signed)
# ---------------------------------------------------------------------------------------------------
# API key (sent as the Authorization header) and user secret (HMAC key) issued by Chainlink.
CHAINLINK_API_KEY=your-data-streams-api-key
CHAINLINK_API_SECRET=your-data-streams-user-secret
# testnet -> https://api.testnet-dataengine.chain.link ; mainnet -> https://api.dataengine.chain.link
CHAINLINK_NETWORK=testnet
# Optional explicit endpoint; overrides CHAINLINK_NETWORK.
# CHAINLINK_ENDPOINT=https://api.testnet-dataengine.chain.link
# Per-request timeout for Data Streams, ms.
CHAINLINK_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------------------------------
# Canton JSON Ledger API v2
# ---------------------------------------------------------------------------------------------------
# Base URL of the participant's JSON API (no trailing slash), e.g. https://participant.example.com/api/json-api
LEDGER_URL=https://participant.example.com
# OAuth2 client-credentials token endpoint. Leave AUTH_TOKEN_URL empty for an unauthenticated sandbox.
AUTH_TOKEN_URL=https://auth.example.com/oauth/token
AUTH_CLIENT_ID=your-client-id
AUTH_CLIENT_SECRET=your-client-secret
# Audience claim requested for the ledger API (Auth0-style); leave empty if your IdP does not use one.
AUTH_AUDIENCE=https://canton.network.global
# Optional OAuth scope (e.g. "daml_ledger_api" for Keycloak setups).
# AUTH_SCOPE=daml_ledger_api
# Token request body encoding: json (Auth0) or form (application/x-www-form-urlencoded, e.g. Keycloak).
AUTH_BODY_FORMAT=json
# Alternative to OAuth: a fixed bearer token (local development only). Takes precedence when set.
# LEDGER_STATIC_TOKEN=
# Optional ledger user id to send with commands (only needed if the token does not imply one).
# LEDGER_USER_ID=
# Synchronizer id used for disclosed contracts when the ledger does not return one.
# SYNCHRONIZER_ID=global-domain::1220...
# Optional comma-separated package ids to prefer when resolving package-name template ids.
# PACKAGE_ID_SELECTION_PREFERENCE=
# Per-request ledger timeout, ms.
LEDGER_TIMEOUT_MS=60000

# Optional separate credentials for the OPERATOR, used by `setup` only. Each falls back to the
# values above when unset (fine when one OAuth client can act as both parties).
# OPERATOR_LEDGER_URL=
# OPERATOR_AUTH_TOKEN_URL=
# OPERATOR_AUTH_CLIENT_ID=
# OPERATOR_AUTH_CLIENT_SECRET=
# OPERATOR_AUTH_AUDIENCE=
# OPERATOR_AUTH_SCOPE=
# OPERATOR_AUTH_BODY_FORMAT=
# OPERATOR_LEDGER_STATIC_TOKEN=

# Package-name references of the deployed DARs (change only if you renamed the packages).
# STORE_PACKAGE_REF=#oracle-price-store
# CHAINLINK_PACKAGE_REF=#oracle-chainlink

# ---------------------------------------------------------------------------------------------------
# Parties
# ---------------------------------------------------------------------------------------------------
# Signatory of the PriceStore and the ChainlinkPriceFeeder. Used by `setup`; also the store filter.
OPERATOR_PARTY=oracle-operator::1220aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Hot pusher key: controller of PushVerifiedPrice; must be an observer of Chainlink's VerifierConfig.
PUSHER_PARTY=oracle-pusher::1220bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# Optional: party `current-store` reads as (default PUSHER_PARTY, else OPERATOR_PARTY).
# READ_AS_PARTY=

# ---------------------------------------------------------------------------------------------------
# Chainlink verifier (needed by `setup` to create the feeder)
# ---------------------------------------------------------------------------------------------------
# Contract ids of the Verifier and of Chainlink's VerifierConfig on your synchronizer.
# Where each comes from: docs/chainlink-onboarding.md.
CHAINLINK_VERIFIER_CID=00replace-with-verifier-contract-id
CHAINLINK_VERIFIER_CONFIG_CID=00replace-with-verifier-config-contract-id
# Chainlink's config-owner party; the feeder only accepts configs owned by it.
CHAINLINK_CONFIG_OWNER_PARTY=chainlink-config-owner::1220cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc

# ---------------------------------------------------------------------------------------------------
# Feeds and push policy
# ---------------------------------------------------------------------------------------------------
# Comma-separated label=feedId (V3 ids, 0x optional). Labels are registered with RegisterFeed by
# `setup`; a bare feedId is pushed but gets no label. Testnet and mainnet ids differ.
FEEDS=ETH-USD=0x000359843a543ee2fe414dc14c7e7920ef10f4372990b79d6361cdc0dd1ba782
# Timing has no defaults. Choose values for your application; see docs/deployment.md.
# How often to fetch reports, ms.
POLL_INTERVAL_MS=
# Force a push at least this often even in a flat market, ms. Must be below the store's
# maxStalenessSeconds, with room for at least one failed push and retry.
HEARTBEAT_MS=
# Per-feed deviation gate in basis points, keyed by label or feed id: push only when the price moved
# at least this much since the last activated price (or on heartbeat).
DEVIATION_BPS=
# Gate for feeds not listed above. 0 = push every poll.
DEFAULT_DEVIATION_BPS=0

# ---------------------------------------------------------------------------------------------------
# Store parameters (used by `setup` when it creates the PriceStore; immutable afterwards)
# ---------------------------------------------------------------------------------------------------
# Strict observation-age bound for writes and GetPrice, seconds.
STORE_MAX_STALENESS_SECONDS=
# Looser bound for GetPriceWithStaleness callers, seconds. Must be >= the strict bound.
STORE_LENIENT_MAX_STALENESS_SECONDS=
# Single-report move above which a price is held pending until corroborated, bps (100 bps = 1%).
STORE_MAX_DEVIATION_BPS=

# ---------------------------------------------------------------------------------------------------
# State, alerting, logging
# ---------------------------------------------------------------------------------------------------
# Local JSON file holding per-feed state (last price, last refresh, alert flags). Persist it.
STATE_FILE=./pusher-state.json
# Alert when no report could be fetched for this long, ms.
STALE_ALERT_MS=
# Alert when the stored price has not been refreshed for this long, ms. Default HEARTBEAT_MS + 2 polls;
# keep it below maxStalenessSeconds so the alert fires before reads start failing.
# PUSH_STALE_MS=
# Optional webhook that receives alerts as JSON (see README). Alerts are always logged regardless.
# ALERT_WEBHOOK_URL=https://hooks.example.com/oracle-alerts
# debug | info | warn | error
LOG_LEVEL=info
